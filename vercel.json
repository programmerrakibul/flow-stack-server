{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",

  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    }
  ],

  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    }
  ]
}
